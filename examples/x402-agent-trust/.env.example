# Ethereum address to receive payments for the demo paid route (server side)
SERVER_ADDRESS=0xYourWalletAddressHere

# Private key for signing payments (client side — test only, never use a real key)
# Get test USDC from https://faucet.circle.com/
CLIENT_TEST_PK=0xYourPrivateKeyHere

# UTA verifier endpoint (x402-native, quotes Base mainnet + base-sepolia)
UTA_VERIFY_URL=https://uta-trust-api.eddyflores100.workers.dev/v1/trust/verify

# Minimum trust band the buyer accepts before spending (B0 < B1 < B2 < B3 < A1)
MIN_TRUST_BAND=B1
