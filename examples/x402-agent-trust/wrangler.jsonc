{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "x402-agent-trust",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/protected-route", "/agent-card.json", "/agents/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "TrustAgent",
        "name": "TRUST_AGENT"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["TrustAgent"],
      "tag": "v1"
    }
  ]
}
